# myvideoto Environment Variables
# Copy this file to .env and fill in the values

# Worker/gateway URL used by the frontend for all download requests.
# The worker routes YouTube to yt-api and other platforms to Cobalt.
# Local dev (worker running via `npx wrangler dev`):
#   VITE_COBALT_API_URL=http://127.0.0.1:8787
# Production (Cloudflare Worker):
#   VITE_COBALT_API_URL=https://myvideoto-api.sashtekapps.workers.dev
VITE_COBALT_API_URL=

# Optional: Enable development mode
# VITE_DEV_MODE=true
