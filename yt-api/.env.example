# myvideoto yt-api environment (copy to .env for local development)
# In production these are set on the Render service instead.

# Secret used to sign /stream tokens (generated automatically if unset —
# set it explicitly in production so restarts don't invalidate live links)
STREAM_SECRET=change-me-to-a-long-random-string

# Optional tuning (defaults shown)
RATE_LIMIT_PER_MIN=10
MAX_CONCURRENT_DOWNLOADS=2
MAX_DURATION_SECONDS=7200
MAX_FILESIZE_BYTES=524288000
TOKEN_TTL_SECONDS=900
